<Window x:Class="TimerManager.App.TimerDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="Timer" Width="500" Height="590" MinWidth="440" MinHeight="500" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="26">
  <TextBlock x:Name="Heading" Text="Add a timer" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,20" />
  <Label Target="{Binding ElementName=NameInput}" Content="_Name" Foreground="{StaticResource TextBrush}" />
  <TextBox x:Name="NameInput" MaxLength="120" AutomationProperties.AutomationId="TimerName" />
  <Label Target="{Binding ElementName=TagsInput}" Content="_Tags · separated by commas" Foreground="{StaticResource TextBrush}" Margin="0,14,0,0" />
  <TextBox x:Name="TagsInput" AutomationProperties.AutomationId="TimerTags" />
  <TextBlock Text="DURATION" FontSize="11" Foreground="{StaticResource AccentBrush}" Margin="0,24,0,8" />
  <UniformGrid x:Name="DurationInputs" Columns="4">
   <StackPanel Margin="0,0,8,0"><Label Target="{Binding ElementName=DaysInput}" Content="Days" Foreground="{StaticResource MutedBrush}" /><TextBox x:Name="DaysInput" Text="0" AutomationProperties.AutomationId="Days" /></StackPanel>
   <StackPanel Margin="0,0,8,0"><Label Target="{Binding ElementName=HoursInput}" Content="Hours" Foreground="{StaticResource MutedBrush}" /><TextBox x:Name="HoursInput" Text="0" AutomationProperties.AutomationId="Hours" /></StackPanel>
   <StackPanel Margin="0,0,8,0"><Label Target="{Binding ElementName=MinutesInput}" Content="Minutes" Foreground="{StaticResource MutedBrush}" /><TextBox x:Name="MinutesInput" Text="5" AutomationProperties.AutomationId="Minutes" /></StackPanel>
   <StackPanel><Label Target="{Binding ElementName=SecondsInput}" Content="Seconds" Foreground="{StaticResource MutedBrush}" /><TextBox x:Name="SecondsInput" Text="0" AutomationProperties.AutomationId="Seconds" /></StackPanel>
  </UniformGrid>
  <TextBlock x:Name="DurationHint" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0" Text="The timer starts as soon as you create it." />
  <TextBlock x:Name="ValidationText" Foreground="#F1C38B" TextWrapping="Wrap" Margin="0,14,0,0" AutomationProperties.LiveSetting="Polite" />
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
   <Button Content="Cancel" IsCancel="True" Margin="0,0,10,0" /><Button x:Name="SaveButton" Content="Start timer" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Save_Click" AutomationProperties.AutomationId="SaveTimer" />
  </StackPanel>
 </StackPanel></ScrollViewer>
</Window>
