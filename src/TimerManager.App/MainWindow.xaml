<Window x:Class="TimerManager.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="Timer Manager" Width="960" Height="730" MinWidth="740" MinHeight="500" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style x:Key="TimerActionItem" TargetType="MenuItem">
   <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
   <Setter Property="Padding" Value="12,8" />
   <Setter Property="MinWidth" Value="150" />
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
    <Border x:Name="ActionSurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
     <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ActionSurface" Property="Background" Value="{StaticResource LineBrush}" /><Setter TargetName="ActionSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ActionSurface" Property="Opacity" Value="0.4" /></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="TimerActionsMenu" TargetType="ContextMenu">
   <Setter Property="FontSize" Value="14" />
   <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
   <Setter Property="Background" Value="{StaticResource PopupBrush}" />
   <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
    <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource ControlLineBrush}" BorderThickness="1" CornerRadius="5" Padding="4" Margin="8">
     <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="3" Opacity="0.5" /></Border.Effect>
     <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
    </Border>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid Margin="28">
  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <Border x:Name="ErrorPanel" Visibility="Collapsed" Background="#383025" CornerRadius="5" Padding="12" Margin="0,0,0,14">
   <DockPanel><Button DockPanel.Dock="Right" Content="Dismiss message" Click="DismissError_Click" Margin="12,0,0,0" />
    <TextBlock x:Name="ErrorText" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" /></DockPanel>
  </Border>
  <TabControl x:Name="Tabs" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0,18,0,0">
   <TabItem Header="_Dashboard">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,16">
      <Button DockPanel.Dock="Right" Content="＋  Add timer" Style="{StaticResource PrimaryButton}" Click="Add_Click" AutomationProperties.AutomationId="AddTimer" />
      <StackPanel VerticalAlignment="Center"><TextBlock Text="Timers" FontSize="20" FontWeight="SemiBold" /><TextBlock x:Name="SummaryText" Style="{StaticResource Muted}" Margin="0,4,0,0" /></StackPanel>
     </DockPanel>
     <StackPanel x:Name="SortControls" Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
      <TextBlock Text="SORT" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0" />
      <RadioButton x:Name="SortRemaining" Content="Soonest first" IsChecked="True" Checked="Sort_Changed" GroupName="Sort" />
      <RadioButton Content="Newest first" Checked="Sort_Changed" GroupName="Sort" Margin="12,0,0,0" />
     </StackPanel>
     <DockPanel x:Name="FilterControls" Grid.Row="2" Margin="0,0,0,10">
      <Button x:Name="ClearFiltersButton" DockPanel.Dock="Right" Content="Clear" ToolTip="Clear tag filters" Click="ClearFilters_Click" Visibility="Collapsed" VerticalAlignment="Top" Padding="8,4" MinHeight="32" Margin="8,0,0,0" />
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="110"><WrapPanel x:Name="TagFilters" /></ScrollViewer>
     </DockPanel>
     <Grid Grid.Row="3">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
       <ItemsControl x:Name="TimerList" ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate><DataTemplate>
         <Border BorderThickness="1" CornerRadius="5" Padding="12,7" Margin="0,0,0,6" MinHeight="64">
          <Border.Style><Style TargetType="Border">
           <Setter Property="Background" Value="{StaticResource PanelBrush}" /><Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
           <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{StaticResource ControlLineBrush}" /></Trigger>
            <DataTrigger Binding="{Binding IsMenuOpen}" Value="True"><Setter Property="Background" Value="{StaticResource LineBrush}" /><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" /></DataTrigger>
           </Style.Triggers>
          </Style></Border.Style>
          <Grid>
           <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
           <Border Grid.ColumnSpan="3" BorderThickness="2,0,0,0" BorderBrush="{StaticResource AccentBrush}" Margin="-12,-7,0,-7" Visibility="{Binding NeedsAttention, Converter={StaticResource VisibleWhenTrue}}" IsHitTestVisible="False" />
           <StackPanel Margin="0,0,20,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
            <DockPanel Margin="0,2,0,0">
             <TextBlock DockPanel.Dock="Left" Text="{Binding StatusText}" FontSize="12">
              <TextBlock.Style><Style TargetType="TextBlock">
               <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
               <Style.Triggers>
                <DataTrigger Binding="{Binding IsMuted}" Value="True"><Setter Property="Foreground" Value="{StaticResource MutedBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding NeedsAttention}" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /></DataTrigger>
               </Style.Triggers>
              </Style></TextBlock.Style>
             </TextBlock>
             <TextBlock Text="{Binding Tags}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Tags}" FontSize="12" Margin="12,0,0,0" Visibility="{Binding HasTags, Converter={StaticResource VisibleWhenTrue}}" />
            </DockPanel>
           </StackPanel>
           <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
            <TextBlock Text="{Binding Countdown}" FontFamily="Consolas" FontSize="28" TextAlignment="Right" AutomationProperties.Name="{Binding AccessibleCountdown}">
             <TextBlock.Style><Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
              <Style.Triggers><DataTrigger Binding="{Binding IsMuted}" Value="True"><Setter Property="Foreground" Value="{StaticResource MutedBrush}" /></DataTrigger></Style.Triggers>
             </Style></TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding TimingDetail}" Style="{StaticResource Muted}" FontSize="11" TextAlignment="Right" ToolTip="{Binding TimingTooltip}" />
           </StackPanel>
           <Button Grid.Column="2" Content="⋯" FontSize="22" Width="36" Height="36" Padding="0" Margin="14,0,0,0" VerticalAlignment="Center" Click="TimerActions_Click" ToolTip="Timer actions" AutomationProperties.Name="{Binding AccessibleActions}" AutomationProperties.AutomationId="TimerActions">
            <Button.ContextMenu>
             <ContextMenu Style="{StaticResource TimerActionsMenu}" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Opened="TimerMenu_Opened" Closed="TimerMenu_Closed">
              <ContextMenu.Resources><Style TargetType="MenuItem" BasedOn="{StaticResource TimerActionItem}" /></ContextMenu.Resources>
              <MenuItem Header="{Binding PauseLabel}" Tag="{Binding Id}" Click="Pause_Click" Visibility="{Binding CanPause, Converter={StaticResource VisibleWhenTrue}}" />
              <MenuItem Header="_Dismiss" Tag="{Binding Id}" Click="Dismiss_Click" Visibility="{Binding NeedsAttention, Converter={StaticResource VisibleWhenTrue}}" />
              <MenuItem Header="_Restart" Tag="{Binding Id}" Click="Restart_Click" />
              <MenuItem Header="_Edit" Tag="{Binding Id}" Click="Edit_Click" />
              <Separator Margin="6,4"><Separator.Template><ControlTemplate TargetType="Separator"><Border Height="1" Background="{StaticResource ControlLineBrush}" /></ControlTemplate></Separator.Template></Separator>
              <MenuItem Header="De_lete" Tag="{Binding Id}" Click="Delete_Click" />
             </ContextMenu>
            </Button.ContextMenu>
           </Button>
          </Grid>
         </Border>
        </DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
      </ScrollViewer>
      <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
       <TextBlock x:Name="EmptyTitle" Text="No timers" FontSize="22" HorizontalAlignment="Center" />
       <TextBlock x:Name="EmptySubtitle" Text="Clear the tag filters to see all timers." Visibility="Collapsed" Style="{StaticResource Muted}" Margin="0,10,0,0" HorizontalAlignment="Center" />
      </StackPanel>
     </Grid>
    </Grid>
   </TabItem>
   <TabItem Header="_Settings">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
     <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
     <Border Background="{StaticResource PanelBrush}" Padding="12" CornerRadius="5" Margin="0,0,0,14"><StackPanel>
      <CheckBox x:Name="PreserveToggle" Checked="Preserve_Changed" Unchecked="Preserve_Changed" AutomationProperties.AutomationId="PreserveRemaining">
       <TextBlock Text="Pause timers while the app is closed or the PC is asleep." TextWrapping="Wrap" />
      </CheckBox>
      <TextBlock Text="On: only time while the app is running and the PC is awake counts.&#10;Off: finish times are kept; overdue timers alert when you return.&#10;Closing to the tray always keeps counting, either way." TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="29,6,0,0" LineHeight="23" />
     </StackPanel></Border>
     <Border Background="{StaticResource PanelBrush}" Padding="12" CornerRadius="5" Margin="0,0,0,20"><StackPanel>
      <CheckBox x:Name="StartupToggle" Content="Start with Windows" Checked="Startup_Changed" Unchecked="Startup_Changed" AutomationProperties.AutomationId="StartWithWindows" />
      <TextBlock Text="Open in the system tray at sign-in. Keep the app folder in the same place after enabling this." TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="29,6,0,0" />
     </StackPanel></Border>
     <StackPanel Margin="12,0,12,12">
     <TextBlock Text="ABOUT THIS INSTALL" FontSize="11" Style="{StaticResource Muted}" />
     <TextBlock Text="Saved on this PC" Margin="0,10,0,0" />
     <TextBlock x:Name="DataPathText" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,8" />
     <Button Content="Open folder" Click="OpenFolder_Click" HorizontalAlignment="Left" Margin="0,0,0,16" />
     <TextBlock Text="One notification and one sound when timers finish. Windows notification settings and your audio volume still apply." Style="{StaticResource Muted}" TextWrapping="Wrap" />
     </StackPanel>
    </StackPanel></ScrollViewer>
     <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,16,12,0" Margin="0,16,0,0">
      <Button Content="Exit Timer Manager" Click="Exit_Click" HorizontalAlignment="Left" />
     </Border>
    </Grid>
   </TabItem>
  </TabControl>
  <TextBlock Grid.Row="2" Text="Closing this window keeps timers running in the tray. Use the tray menu to exit." Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,16,0,0" />
 </Grid>
</Window>
