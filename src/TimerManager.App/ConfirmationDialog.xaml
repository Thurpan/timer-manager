<Window x:Class="TimerManager.App.ConfirmationDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Width="460" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="26">
  <TextBlock x:Name="Heading" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16" />
  <TextBlock x:Name="Message" TextWrapping="Wrap" />
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
   <Button x:Name="ConfirmButton" Click="Confirm_Click" Margin="0,0,10,0" />
   <Button x:Name="CancelButton" Content="Cancel" IsDefault="True" IsCancel="True" />
  </StackPanel>
 </StackPanel></ScrollViewer>
</Window>
